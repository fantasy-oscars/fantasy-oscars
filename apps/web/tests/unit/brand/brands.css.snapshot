  --brand-display-word-spacing: normal;
  --brand-h1-size: 32px;
  --brand-h2-size: 24px;
  --brand-h3-size: 16px;
  --brand-body-size: 14px;
  --brand-wordmark-font: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --brand-wordmark-weight: 600;
  --brand-wordmark-case: none;
  --brand-wordmark-letter-spacing: -0.02em;
  --brand-wordmark-two-tone: weight;
  --brand-radius-sm: 0;
  --brand-radius-md: 0;
  --brand-radius-lg: 0;
  --brand-button-shape: square;
  --brand-button-radius: 0;
  --brand-border-width: 1px;
  --brand-rule-style: solid;
  --brand-nav-active: underline;
  --brand-nav-font: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --brand-nav-case: none;
  --brand-nav-size: 13px;
  --brand-deco-double-rules: 0;
  --brand-deco-offset-shadow: 0;
  --brand-deco-frame-borders: 1;
  --brand-deco-grease-pencil: 1;
  --brand-nav-pill: 0;
  --brand-nav-indicator: var(--brand-accent);
  --brand-nav-active-bg: transparent;
  --brand-nav-active-fg: var(--brand-text);
  --brand-nav-active-border: var(--brand-accent);
  --brand-nav-border-width: 0 0 2px;
  --brand-nav-letter-spacing: normal;
  --brand-section-rule: var(--brand-border-width) solid var(--brand-text);
  --brand-nav-rule: var(--brand-section-rule);
  --brand-wordmark-tone-color: inherit;
  --brand-wordmark-tone-style: normal;
  --brand-wordmark-tone-weight: 400;
  --brand-wordmark-stop-display: none;
  --brand-wordmark-stop-color: var(--brand-accent);
  --brand-home-layout: lightbox;
  --brand-light-page: #ecedea;
  --brand-light-page-rgb: 236, 237, 234;
  --brand-light-surface: #ffffff;
  --brand-light-surface-rgb: 255, 255, 255;
  --brand-light-raised: #ffffff;
  --brand-light-raised-rgb: 255, 255, 255;
  --brand-light-sunken: #e4e5e1;
  --brand-light-sunken-rgb: 228, 229, 225;
  --brand-light-text: #141414;
  --brand-light-text-rgb: 20, 20, 20;
  --brand-light-muted: #575754;
  --brand-light-muted-rgb: 87, 87, 84;
  --brand-light-faint: #a8a8a3;
  --brand-light-faint-rgb: 168, 168, 163;
  --brand-light-rule: #cfcfcb;
  --brand-light-rule-rgb: 207, 207, 203;
  --brand-light-rule-strong: #7f807e;
  --brand-light-rule-strong-rgb: 127, 128, 126;
  --brand-light-primary: #141414;
  --brand-light-primary-rgb: 20, 20, 20;
  --brand-light-on-primary: #ffffff;
  --brand-light-on-primary-rgb: 255, 255, 255;
  --brand-light-accent: #b8213a;
  --brand-light-accent-rgb: 184, 33, 58;
  --brand-light-link: #141414;
  --brand-light-link-rgb: 20, 20, 20;
  --brand-light-link-hover: #575754;
  --brand-light-link-hover-rgb: 87, 87, 84;
  --brand-light-focus-ring: #141414;
  --brand-light-focus-ring-rgb: 20, 20, 20;
  --brand-light-shadow-card: 0 0 0 1px #141414;
  --brand-light-shadow-raised: 0 0 0 2px #141414;
  --brand-light-shadow-overlay: 0 0 0 1px #141414;
  --brand-dark-page: #170f10;
  --brand-dark-page-rgb: 23, 15, 16;
  --brand-dark-surface: #221718;
  --brand-dark-surface-rgb: 34, 23, 24;
  --brand-dark-raised: #221718;
  --brand-dark-raised-rgb: 34, 23, 24;
  --brand-dark-sunken: #2c1f20;
  --brand-dark-sunken-rgb: 44, 31, 32;
  --brand-dark-text: #f2e6e4;
  --brand-dark-text-rgb: 242, 230, 228;
  --brand-dark-muted: #b49a98;
  --brand-dark-muted-rgb: 180, 154, 152;
  --brand-dark-faint: #6e5254;
  --brand-dark-faint-rgb: 110, 82, 84;
  --brand-dark-rule: #4a3537;
  --brand-dark-rule-rgb: 74, 53, 55;
  --brand-dark-rule-strong: #756b6b;
  --brand-dark-rule-strong-rgb: 117, 107, 107;
  --brand-dark-primary: #f2e6e4;
  --brand-dark-primary-rgb: 242, 230, 228;
  --brand-dark-on-primary: #170f10;
  --brand-dark-on-primary-rgb: 23, 15, 16;
  --brand-dark-accent: #f0566a;
  --brand-dark-accent-rgb: 240, 86, 106;
  --brand-dark-link: #f2e6e4;
  --brand-dark-link-rgb: 242, 230, 228;
  --brand-dark-link-hover: #b49a98;
  --brand-dark-link-hover-rgb: 180, 154, 152;
  --brand-dark-focus-ring: #f2e6e4;
  --brand-dark-focus-ring-rgb: 242, 230, 228;
  --brand-dark-shadow-card: 0 0 0 1px #f2e6e4;
  --brand-dark-shadow-raised: 0 0 0 2px #f2e6e4;
  --brand-dark-shadow-overlay: 0 0 0 1px #f2e6e4;
}

