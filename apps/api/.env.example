# Local dev / docker-compose Postgres
PORT=4010
AUTH_SECRET=local-dev-secret
DATABASE_URL=postgres://fantasy:fantasy@localhost:5433/fantasy_oscars

# CORS for Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Number of reverse proxies in front of the API (default: 1 in production, false otherwise)
# TRUST_PROXY=false

# SameSite for the auth cookie: lax | strict | none (default: none in production, lax
# otherwise). Use lax when web and API share an origin; none needs NODE_ENV=production.
# AUTH_COOKIE_SAMESITE=lax

# Postgres pool (optional; defaults shown)
# PG_POOL_MAX=10
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_IDLE_TIMEOUT_MS=30000

# Realtime websockets (optional)
REALTIME_ENABLED=true

# TMDB (optional; used to hydrate films/people by tmdb_id)
# Create a v4 "Read access token" in TMDB and set it here.
# Used by: `syncTmdbMovieById` / `syncTmdbPersonById` and `tsx src/scripts/sync-tmdb.ts`
TMDB_READ_ACCESS_TOKEN=

# Run the migrator before booting (default true). Set false when migrations run as a
# separate release step (`pnpm --filter @fantasy-oscars/api run migrate`); the API then
# refuses to start if the database is behind.
# MIGRATE_ON_START=true
# The boot check also applies to `pnpm dev`: run `pnpm run db:migrate` first.

# Idle sweeper fallback poll in ms (default 600000; 0 disables). A suspend-on-idle DB may wake at this interval.
# DRAFT_SWEEPER_IDLE_POLL_MS=600000

# Milliseconds to wait for in-flight requests on SIGTERM/SIGINT (default 10000)
# SHUTDOWN_TIMEOUT_MS=10000

# Error tracking (optional; Sentry is disabled when SENTRY_DSN is unset)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
